# Copy this file to .env.development (for local development) and fill in values.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app code by Expo.

# Base URL of the backend API (no trailing path — the /api/v1 prefix is added in code)
EXPO_PUBLIC_API_URL=https://powderblue-rook-471609.hostingersite.com

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# true to see verbose console logs, false to silence them
EXPO_PUBLIC_ENABLE_LOGS=true
